<h2>Productos</h2>
<hr>
<input type="text" value="{{carrito._id}}" hidden id="carrito">
<ul>
    {{#each productos}}
        <li>
            <strong>{{descripcion}}</strong> - precio: {{precio}} <button onclick="comprar('{{_id}}')">Comprar</button>
        </li>
        
    {{/each}}
</ul>



<br>
<br>

<a href="/carrito/{{carrito._id}}">Ver carrito</a>
<br>
{{>menu}}

<script src="/js/productos.js"></script>